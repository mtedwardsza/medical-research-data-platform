# =============================================================
# .gitignore — Medical Research Data Migration Platform
# =============================================================
# This file tells Git which files to IGNORE (not track).
# Anything listed here will never be uploaded to GitHub.
# =============================================================


# --- Passwords and secrets -----------------------------------
# .env contains database credentials and secret keys.
# NEVER upload this to GitHub — it would expose your passwords.
.env


# --- Python temporary files ----------------------------------
# Python creates these automatically when it runs your code.
# They are not source code — just cache files that speed up execution.
__pycache__/
*.py[cod]
*.pyo
*.pyd


# --- Virtual environments ------------------------------------
# A virtual environment is a local Python installation for this project.
# It can weigh 200-500 MB and is easily recreated with: pip install -r requirements.txt
venv/
.venv/
env/


# --- Data files ----------------------------------------------
# Raw CSVs are generated by generate_data.py — no need to store them in GitHub.
# Processed CSVs are also regenerated by process_data.py.
# Exception: we DO track the Data/ folder structure (via .gitkeep files).
Data/raw/*.csv
Data/processed/*.csv


# --- Jupyter Notebook checkpoints ----------------------------
# Jupyter saves automatic checkpoints in this hidden folder.
# They are backups, not source code.
.ipynb_checkpoints/


# --- Mac system files ----------------------------------------
# macOS creates .DS_Store in every folder you open in Finder.
# It stores display preferences — completely irrelevant to the project.
.DS_Store


# --- IDE and editor files ------------------------------------
# Personal editor settings — different for every developer.
.vscode/
.idea/
*.swp


# --- Logs ----------------------------------------------------
# Log files grow indefinitely and belong in the server, not GitHub.
*.log
logs/

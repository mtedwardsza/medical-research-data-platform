# .env.example
# =============
# Template for environment variables required to run this project.
#
# HOW TO USE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your own values in .env
#   3. NEVER commit .env to Git — it's already in .gitignore
#
# WHY ENVIRONMENT VARIABLES:
#   Hardcoding passwords and secrets in code is a security risk.
#   Environment variables keep sensitive config outside the codebase,
#   so the same code can run in dev, staging, and production with
#   different credentials — without changing a single line of code.

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_DB=research_db
POSTGRES_USER=research_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ── Full Database URL (constructed from above — used by SQLAlchemy) ───────────
DATABASE_URL=postgresql://research_user:change_me_in_production@localhost:5432/research_db

# ── Flask Application ─────────────────────────────────────────────────────────
# SECRET_KEY: used to sign session cookies — must be long, random, and secret
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string_in_production

# FLASK_ENV: "development" enables debug mode and auto-reload
# Use "production" for deployment
FLASK_ENV=development

# Port the Flask app listens on
APP_PORT=5000
